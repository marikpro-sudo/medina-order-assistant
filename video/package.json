{
  "name": "medina-demo-video",
  "private": true,
  "type": "module",
  "scripts": {
    "record": "node record.mjs",
    "record:en": "node record.mjs --lang=en",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts MedinaDemo out/medina-demo-ru.mp4 --concurrency=2 --offthreadvideo-cache-size-in-bytes=536870912",
    "render:en": "remotion render src/index.ts MedinaDemo out/medina-demo-en.mp4 --props=props-en.json --concurrency=2 --offthreadvideo-cache-size-in-bytes=536870912"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.539",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.539"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "playwright": "^1.64.1",
    "typescript": "^5.6.3"
  }
}
